{
  "name": "obsidian-vscode-file-tree",
  "version": "1.0.0",
  "description": "类 VSCode 的文件树侧边栏：展示全部文件、扩展名过滤、自动定位当前文件、搜索与拖拽",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/install.mjs"
  },
  "author": "启年",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3"
  }
}
